{
  "layer": "top",
  "position": "top",

  "height": 38,
  "spacing": 5,

  "margin-top": 3,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": [
    "custom/launcher",
    "custom/theme",
    "custom/screenshot",
    "custom/clipboard",
    "custom/files",
    "custom/lock",
    "mpris"
  ],

  "modules-center": [
    "niri/workspaces"
  ],

  "modules-right": [
    "tray",
    "niri/language",
    "pulseaudio",
    "bluetooth",
    "network",
    "custom/date",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "Aplicativos",
    "on-click": "fuzzel"
  },

  "custom/theme": {
    "format": "󰏘",
    "tooltip": true,
    "tooltip-format": "Aparência",
    "on-click": "nwg-look"
  },

  "custom/screenshot": {
    "format": "󰄀",
    "tooltip": true,
    "tooltip-format": "Capturar uma área",
    "on-click": "grim -g \"$(slurp)\" - | wl-copy"
  },

  "custom/clipboard": {
    "format": "󰅌",
    "tooltip": true,
    "tooltip-format": "Área de transferência",
    "on-click": "cliphist list | wofi --dmenu | cliphist decode | wl-copy"
  },

  "custom/files": {
    "format": "󰉋",
    "tooltip": true,
    "tooltip-format": "Arquivos",
    "on-click": "thunar"
  },

  "custom/lock": {
    "format": "󰌾",
    "tooltip": true,
    "tooltip-format": "Bloquear sessão",
    "on-click": "/home/joelzinho/.config/swaylock/lock.sh"
  },

  "mpris": {
    "format": "󰎆 {artist} — {title}",
    "format-paused": "󰏤 {artist} — {title}",
    "format-stopped": "󰝛",
    "max-length": 32,
    "tooltip": true
  },

"niri/workspaces": {
    "format": "{value}",
    "all-outputs": false,
    "sort-by-id": true
},

  "tray": {
    "spacing": 4,
    "icon-size": 15
  },

  "niri/language": {
    "format": "{short}",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },

  "bluetooth": {
    "format-off": "󰂲",
    "format-on": "",
    "format-connected": "",
    "tooltip-format": "Bluetooth: {status}",
    "on-click": "blueman-manager"
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid}\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "custom/date": {
    "exec": "/home/joelzinho/.config/waybar/date.sh",
    "interval": 30,
    "tooltip": false
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": true,
    "tooltip-format": "Desligar / sair",
    "on-click": "wlogout"
  }
}
